# ==========================================
# PricePulse VSA — Environment Configuration
# ==========================================

# 1. Runtime & Server
NODE_ENV=development
PORT=3333
LOG_LEVEL=debug

# 2. Documentation (Swagger/OpenAPI)
# Controls whether Swagger UI is available at /api/docs.
# Set to false in production to prevent surface attack discovery.
SWAGGER_ENABLED=true

# 3. PostgreSQL Database (Drizzle ORM)
DATABASE_URL=postgres://pricepulse:pricepulse_secret@localhost:5432/pricepulse

# 4. Valkey 8 (BullMQ Queues & Sliding-Window Rate Limiting)
VALKEY_URL=redis://localhost:6379

# 5. NATS 2.10 JetStream (Distributed Event Streaming)
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=PRICEPULSE

# 6. Notifications (Mailpit in Development / SMTP or Resend in Production)
EMAIL_PROVIDER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=alerts@pricepulse.dev

# 7. Observability & Tracing (OpenTelemetry -> Jaeger)
OTEL_SERVICE_NAME=pricepulse-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# 8. Security & Scraping
MAX_TRACKED_URLS_PER_IP_WINDOW=10
SCRAPING_RATE_LIMIT_PER_DOMAIN_RPS=2
